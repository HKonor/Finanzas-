# Cópialo a .env y genera una SECRET_KEY larga y aleatoria antes de publicar.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DB_ENGINE=sqlite
# Para PostgreSQL: DB_ENGINE=postgresql y rellena todos los campos.
DB_NAME=finanza_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# En desarrollo se muestran los enlaces de activación en la consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar correo REAL: cambia EMAIL_BACKEND a django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Finanza <no-reply@example.com>
DEFAULT_APP_URL=http://127.0.0.1:8000
ADMIN_EMAIL=admin@finanza.local
ADMIN_USERNAME=administrador
ADMIN_PASSWORD=
SECURE_SSL_REDIRECT=false
